<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No App Sandbox: Chorus spawns agent CLIs and reads the user's repo
         (see build.sh). Hardened runtime only. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Agents run node/npx children that map JIT memory. -->
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <!-- Sparkle loads its own signed framework; user-installed CLIs are not signed by us. -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
